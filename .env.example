# ---------------------------------------------------------------------------
# Singapore Rain & Laundry Advisor — environment variables
# Copy to `.env.local` for local dev, and add the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# ---------------------------------------------------------------------------

# Upstash Redis (REST). Create a free DB at https://console.upstash.com/redis
# and copy these from the database's "REST API" panel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Telegram bot (primary channel, multi-user) -----------------------------
# Create a bot with @BotFather to get the token. There's no "your chat id" to
# set here — the bot is open to anyone on Telegram, and each chat registers
# its own location by sharing a Location or sending /setlocation (see the
# README "Telegram bot" section).
TELEGRAM_BOT_TOKEN=

# Secret Telegram signs every webhook request with, so /api/telegram/webhook
# can tell real Telegram traffic from anyone else who finds the URL. Generate
# with:  openssl rand -hex 32   (same idea as CRON_SECRET, just for a different
# route). See the README for the one-time setWebhook call needed after this
# is set.
TELEGRAM_WEBHOOK_SECRET=

# --- Web Push (optional / dormant) -----------------------------------------
# The browser-push channel is kept in the code but is not the primary path.
# Leave these blank to run on Telegram alone. To use browser push as well,
# generate the keys once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URL. Push services use it to contact you if your
# notifications misbehave. Your own email is fine.
VAPID_SUBJECT=mailto:your-email@example.com

# Shared secret for the externally-triggered rain checker. Generate with:
#   openssl rand -hex 32
# The scheduler must send it as:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
